{
  "name": "credguard",
  "displayName": "CredGuard",
  "description": "Real-time Visual Studio Code extension for detecting hardcoded credentials using Pattern Matching (Regex) and Shannon Entropy.",
  "version": "1.0.0",
  "publisher": "jattkidz",
  "icon": "images/iconcg.png",
  "license": "MIT",
  "main": "./out/extension.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/jattkidz/CredGuard"
  },
  "bugs": {
    "url": "https://github.com/jattkidz/CredGuard/issues"
  },
  "homepage": "https://github.com/jattkidz/CredGuard#readme",
  "engines": {
    "vscode": "^1.109.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "credguard.scanNow",
        "title": "CredGuard: Scan File Sekarang"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.19",
    "@types/vscode": "^1.109.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0"
  },
  "dependencies": {
    "csv-parser": "^3.2.1"
  }
}
